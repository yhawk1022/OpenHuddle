# OpenHuddle 运行配置（/etc/openhuddle/openhuddle.env，首次安装自动生成，后续发布不会覆盖）
NODE_ENV=production
# 仅监听本机回环，由 nginx 反向代理对外提供 HTTPS
HOST=127.0.0.1
PORT=18789
LOG_LEVEL=info
PUBLIC_BASE_URL=https://www.cyanarch.com

# 单机 2C4G：嵌入式 PGlite 持久化 + 进程内实时总线（零 Postgres / Redis 运维）
DATABASE_URL=file:///var/lib/openhuddle/pglite
REALTIME_BUS_DRIVER=memory

AUTH_SECRET=__AUTH_SECRET__

# 注册与邮件：复用主机 cyanarch-mail 的阿里云 DirectMail 凭据（smtpdm.aliyun.com:465）
SMTP_CREDENTIALS_FILE=/etc/openhuddle/smtp.json
SMTP_FROM_NAME=OpenHuddle
ALLOW_PUBLIC_SIGNUP=true
ALLOW_DEV_OTP_ECHO=false
# ADMIN_EMAILS=you@example.com
