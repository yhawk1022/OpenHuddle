{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "public/openhuddle.mjs"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "PORT",
        "LOG_LEVEL",
        "PUBLIC_BASE_URL",
        "REALTIME_BUS_DRIVER",
        "AUTH_SECRET",
        "ALLOW_DEV_OTP_ECHO",
        "ALLOW_PUBLIC_SIGNUP",
        "ALLOWED_EMAIL_DOMAINS",
        "ADMIN_EMAILS",
        "SMTP_*",
        "AI_*"
      ]
    }
  }
}
