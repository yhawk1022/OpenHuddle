# ==============================================================================
# OpenHuddle Environment Configuration Template (.env.example)
# Copy to `.env` for local overrides. Zero config is needed for local `pnpm dev`
# as OpenHuddle defaults to embedded PGlite (`file://./.data/pglite`).
# ==============================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# Storage:
# - `memory://`             -> Ephemeral in-memory PGlite (automated tests)
# - `file://./.data/pglite` -> Zero-Docker local embedded PostgreSQL (default)
# - `postgres://user:pass@localhost:5432/openhuddle` -> Production PostgreSQL 16+
DATABASE_URL=file://./.data/pglite

# Realtime Event Bus:
# - `memory`   -> Zero-overhead single-process bus (default, ideal for 2C4G single container)
# - `postgres` -> PostgreSQL LISTEN/NOTIFY cross-process bus (zero-Redis rolling deploys)
REALTIME_BUS_DRIVER=memory

# Auth Secret (minimum 32 random characters in production)
AUTH_SECRET=dev-only-insecure-secret-change-in-production-32chars
