# ==============================================================================
# OpenHuddle Environment Configuration Template (.env.example)
# Copy to `.env` for local overrides or 2C4G Docker Compose deployment.
# Zero config is needed for local `pnpm dev` (defaults to embedded PGlite).
# ==============================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# Storage:
# - `memory://`             -> Ephemeral in-memory PGlite (automated tests)
# - `file://./.data/pglite` -> Zero-Docker local embedded PostgreSQL (default)
# - `postgresql://openhuddle:pass@localhost:5432/openhuddle` -> Production PostgreSQL 16+
DATABASE_URL=file://./.data/pglite

# Realtime Event Bus (No Redis Required):
# - `memory`   -> Zero-overhead single-process bus (default for local & single-container)
# - `postgres` -> PostgreSQL LISTEN/NOTIFY cross-process bus (multi-replica deploys)
REALTIME_BUS_DRIVER=memory

# Auth Secret (minimum 32 random characters required in production)
AUTH_SECRET=dev-only-insecure-secret-change-in-production-32chars
# Optional: when SMTP is unconfigured in dev/test, verification codes automatically fall back to dev_echo.
# Set to `false` in production; only set `true` when explicitly debugging without SMTP.
ALLOW_DEV_OTP_ECHO=
# Self-hosting signup controls:
ALLOW_PUBLIC_SIGNUP=true
# Optional comma-separated domain allowlist (e.g. `company.com,partner.org`); empty allows any email domain
ALLOWED_EMAIL_DOMAINS=
# Minimum seconds between verification emails per (email, purpose)
OTP_RESEND_COOLDOWN_SEC=60
# Optional comma-separated list of admin email addresses (pinned super-admins; when empty, first registered user becomes admin)
ADMIN_EMAILS=

# ==============================================================================
# SMTP Email Delivery (Registration activation & password reset codes)
# Supports standard SMTP_* env vars (Docker/production) or an optional JSON
# credentials file via SMTP_CREDENTIALS_FILE.
# Explicit SMTP_* env vars always override values from SMTP_CREDENTIALS_FILE.
# ==============================================================================
SMTP_CREDENTIALS_FILE=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=OpenHuddle
SMTP_TIMEOUT_MS=15000

# Optional BYOK AI Moderator Synthesis (OpenAI-compatible endpoint; falls back to deterministic heuristic synthesis when empty)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Docker Compose 2C4G Self-Hosting Variables (`docker compose pull && docker compose up -d`)
OPENHUDDLE_DOMAIN=:80
POSTGRES_PASSWORD=change-me-strong-postgres-password
